{
  "componentName": "DrDataTable",
  "displayName": "数据表格",
  "description": "数据表格、明细表、列表、分页、搜索、排序、设备清单、告警记录。实际 ChartConfig.type 必须为 DrDataTable。fields.defaultValue 默认对应 visualScreen；两种页面的默认值差异见字段 description，必须按目标 pageType 选择：page 的 w/h 为网格份数，visualScreen 的 w/h 为像素，不可混用。",
  "fields": [
    {
      "field": "id",
      "type": "string",
      "description": "唯一标识，必填"
    },
    {
      "field": "i",
      "type": "string",
      "description": "唯一标识，当pageType=page时必填，默认与id保持一致"
    },
    {
      "field": "type",
      "type": "string",
      "description": "组件类型；实际 ChartConfig.type 必须为 DrDataTable，不可使用预设 id。",
      "defaultValue": "DrDataTable"
    },
    {
      "field": "title",
      "type": "string",
      "description": "组件显示的图层名称 或 卡片名称",
      "defaultValue": "数据表格"
    },
    {
      "field": "w",
      "type": "number",
      "description": "宽度或占用的份数；默认值须按 pageType 选择，page=16（网格份数），visualScreen=640（像素）。",
      "defaultValue": 640
    },
    {
      "field": "h",
      "type": "number",
      "description": "高度或占用的份数；默认值须按 pageType 选择，page=5（网格份数），visualScreen=360（像素）。",
      "defaultValue": 360
    },
    {
      "field": "x",
      "type": "number",
      "description": "x坐标或x轴份数",
      "defaultValue": 0
    },
    {
      "field": "y",
      "type": "number",
      "description": "y坐标或y轴份数",
      "defaultValue": 0
    },
    {
      "field": "z",
      "type": "number",
      "description": "组件层级、层级越大、越靠前显示",
      "defaultValue": 0
    },
    {
      "field": "rotateX",
      "type": "number",
      "description": "X轴旋转角度",
      "defaultValue": 0
    },
    {
      "field": "rotateY",
      "type": "number",
      "description": "Y轴旋转角度",
      "defaultValue": 0
    },
    {
      "field": "rotateZ",
      "type": "number",
      "description": "Z轴旋转角度",
      "defaultValue": 0
    },
    {
      "field": "hide",
      "type": "boolean",
      "description": "是否隐藏组件，true 时设计器与预览不渲染"
    },
    {
      "field": "children",
      "type": "array",
      "description": "子组件，仅在容器类组件有效"
    },
    {
      "field": "behaviors",
      "type": "object",
      "description": "图表交互",
      "defaultValue": {}
    },
    {
      "field": "dataset.code",
      "type": "string",
      "description": "数据集编码",
      "defaultValue": ""
    },
    {
      "field": "dataset.datasetType",
      "type": "enum",
      "description": "数据集类型，历史配置可为空",
      "options": [
        "",
        "directory",
        "json",
        "http",
        "sql",
        "excel",
        "es",
        "websocket",
        "mqtt"
      ],
      "defaultValue": ""
    },
    {
      "field": "dataset.fields",
      "type": "object",
      "description": "字段绑定，key为组件可绑定的维度、指标、属性等字段名（见组件datasetFields定义），value为绑定的数据集字段名数组",
      "defaultValue": {}
    },
    {
      "field": "dataset.script",
      "type": "string",
      "description": "数据处理脚本",
      "defaultValue": ""
    },
    {
      "field": "dataset.params",
      "type": "object",
      "description": "数据集入参、如果数据集需要入参的话",
      "defaultValue": {}
    },
    {
      "field": "props.global.padding",
      "type": "array",
      "description": "padding",
      "defaultValue": [
        0,
        0,
        0,
        0
      ]
    },
    {
      "field": "props.global.backgroundColor",
      "type": "string",
      "description": "backgroundColor",
      "defaultValue": "transparent"
    },
    {
      "field": "props.global.borderColor",
      "type": "string",
      "description": "borderColor",
      "defaultValue": "var(--el-border-color)"
    },
    {
      "field": "props.global.borderWidth",
      "type": "number",
      "description": "borderWidth",
      "defaultValue": 0
    },
    {
      "field": "props.global.borderRadius",
      "type": "number",
      "description": "borderRadius",
      "defaultValue": 6
    },
    {
      "field": "props.table.size",
      "type": "enum",
      "description": "size",
      "options": [
        "large",
        "default",
        "small"
      ],
      "defaultValue": "default"
    },
    {
      "field": "props.table.border",
      "type": "boolean",
      "description": "border",
      "defaultValue": false
    },
    {
      "field": "props.table.stripe",
      "type": "boolean",
      "description": "stripe",
      "defaultValue": true
    },
    {
      "field": "props.table.fit",
      "type": "boolean",
      "description": "fit",
      "defaultValue": true
    },
    {
      "field": "props.table.showIndex",
      "type": "boolean",
      "description": "showIndex",
      "defaultValue": false
    },
    {
      "field": "props.table.emptyText",
      "type": "string",
      "description": "emptyText",
      "defaultValue": "暂无数据"
    },
    {
      "field": "props.headerStyle.height",
      "type": "number",
      "description": "height",
      "defaultValue": 42
    },
    {
      "field": "props.headerStyle.backgroundColor",
      "type": "string",
      "description": "backgroundColor",
      "defaultValue": "transparent"
    },
    {
      "field": "props.headerStyle.color",
      "type": "string",
      "description": "color",
      "defaultValue": "var(--el-text-color-regular)"
    },
    {
      "field": "props.headerStyle.fontSize",
      "type": "number",
      "description": "fontSize",
      "defaultValue": 14
    },
    {
      "field": "props.headerStyle.fontWeight",
      "type": "enum",
      "description": "fontWeight",
      "options": [
        "normal",
        "bold",
        "bolder"
      ],
      "defaultValue": "bold"
    },
    {
      "field": "props.headerStyle.textAlign",
      "type": "enum",
      "description": "textAlign",
      "options": [
        "left",
        "center",
        "right"
      ],
      "defaultValue": "left"
    },
    {
      "field": "props.rowStyle.height",
      "type": "number",
      "description": "height",
      "defaultValue": 40
    },
    {
      "field": "props.rowStyle.backgroundColor",
      "type": "string",
      "description": "backgroundColor",
      "defaultValue": "transparent"
    },
    {
      "field": "props.rowStyle.oddBackgroundColor",
      "type": "string",
      "description": "oddBackgroundColor",
      "defaultValue": "transparent"
    },
    {
      "field": "props.rowStyle.evenBackgroundColor",
      "type": "string",
      "description": "evenBackgroundColor",
      "defaultValue": "transparent"
    },
    {
      "field": "props.rowStyle.hoverBackgroundColor",
      "type": "string",
      "description": "hoverBackgroundColor",
      "defaultValue": "var(--el-fill-color-light)"
    },
    {
      "field": "props.rowStyle.borderColor",
      "type": "string",
      "description": "borderColor",
      "defaultValue": "var(--el-border-color-lighter)"
    },
    {
      "field": "props.cellStyle.color",
      "type": "string",
      "description": "color",
      "defaultValue": "var(--el-text-color-regular)"
    },
    {
      "field": "props.cellStyle.fontSize",
      "type": "number",
      "description": "fontSize",
      "defaultValue": 14
    },
    {
      "field": "props.cellStyle.fontWeight",
      "type": "enum",
      "description": "fontWeight",
      "options": [
        "normal",
        "bold",
        "bolder"
      ],
      "defaultValue": "normal"
    },
    {
      "field": "props.cellStyle.padding",
      "type": "array",
      "description": "padding",
      "defaultValue": [
        8,
        12,
        8,
        12
      ]
    },
    {
      "field": "props.cellStyle.overflow",
      "type": "enum",
      "description": "overflow",
      "options": [
        "ellipsis",
        "wrap",
        "clip"
      ],
      "defaultValue": "ellipsis"
    },
    {
      "field": "props.cellStyle.showTooltip",
      "type": "boolean",
      "description": "showTooltip",
      "defaultValue": true
    },
    {
      "field": "props.columnStyles",
      "type": "array",
      "description": "按实际数据字段覆盖列样式，不参与列生成。元素包含 field（必填字段名）、label（表头名称）、width（列宽px，省略则自适应）、headerFontSize/headerColor（表头字号/颜色）、fontSize/color（正文字号/颜色）、showTooltip（溢出提示布尔值）。可选属性省略时继承全表设置，提示仅在省略模式生效。",
      "defaultValue": []
    },
    {
      "field": "props.formatting.defaultNumberFormat",
      "type": "enum",
      "description": "defaultNumberFormat",
      "options": [
        "text",
        "value",
        "integer",
        "float1",
        "float2",
        "percent",
        "percent0",
        "percent1",
        "percent2",
        "thousand",
        "currency",
        "date"
      ],
      "defaultValue": "value"
    },
    {
      "field": "props.formatting.dateFormat",
      "type": "string",
      "description": "dateFormat",
      "defaultValue": "YYYY-MM-DD HH:mm:ss"
    },
    {
      "field": "props.formatting.nullText",
      "type": "string",
      "description": "nullText",
      "defaultValue": "--"
    }
  ],
  "datasetFields": [
    {
      "name": "displayFields",
      "desc": "显示字段列表，未配置时使用数据集返回的全部字段",
      "required": false,
      "multiple": true
    }
  ]
}
