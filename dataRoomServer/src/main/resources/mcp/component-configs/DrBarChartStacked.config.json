    {
      "field": "props.xAxis.axisLine.color",
      "type": "string",
      "description": "color；默认值须按 pageType 选择，page=\"#D8DFE6\"，visualScreen=\"#8BA3C7\"。",
      "defaultValue": "#8BA3C7"
    },
    {
      "field": "props.xAxis.axisLine.width",
